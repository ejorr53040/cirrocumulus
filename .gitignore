# --- Rust / Cargo ---
# Compiled output (this is a workspace of binaries, so Cargo.lock IS committed —
# see https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html)
/target/
debug/

# rustfmt backup files
**/*.rs.bk

# MSVC debug symbols (if ever cross-built on Windows)
*.pdb

# --- Secrets / local config ---
.env
.env.*
*.pem
*.key
secrets/

# --- Firecracker / VM artifacts (local dev only, per design doc's Storage section) ---
/data/
*.snap
*.ext4
*.erofs
*.rootfs
vmlinux*
firecracker
jailer

# --- Step 0 build artifacts (downloaded kernel, staged rootfs tree, sockets/logs) ---
/scripts/step0/.build/

# --- App demo build artifacts (cloned app source, Alpine packages, rootfs, sockets/logs) ---
/scripts/apps/*/.build/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
*.swp

# --- Logs ---
*.log

# --- Internal planning docs (not for distribution) ---
BUILD_PATHWAY.md
BUILD_PATHWAY.v1-*.md
RESEARCH.md
RESEARCH.v1-*.md
INVESTOR_GUIDE.md
SECURITY_AUDIT.md


# --- Reference docs & visualzations (youre welcome claude) ---
/docs/rust-book/
/graphify-out/

# --- Test App build artifacts (Alpine packages, rootfs images) ---
/scripts/test-apps/.build/
